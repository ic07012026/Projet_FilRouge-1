# Azure OpenAI : URL de la ressource, sans suffixe /openai/v1/.
AZURE_OPENAI_ENDPOINT=https://votre-ressource.openai.azure.com
AZURE_OPENAI_API_KEY=votre-cle-api-azure

# Nom du deploiement de chat cree dans Azure AI Foundry.
CHAT_DEPLOYMENT=nom-du-deploiement-chat

# Chemin absolu ou relatif au dossier du projet.
FICHES_REPERTOIRE=fiches_fournisseurs

# MySQL : utiliser un compte disposant uniquement de droits de lecture.
DB_HOST=localhost
DB_PORT=3306
DB_USER=agent_ia
DB_PASSWORD=votre-mot-de-passe-mysql
DB_NAME=catalogue